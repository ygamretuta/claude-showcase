{
  "name": "claude-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "payload migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "payload run scripts/sync.ts",
    "covers": "node design/covers/build.mjs && payload run scripts/apply-covers.ts",
    "migrate:create": "BLOB_READ_WRITE_TOKEN=vercel_blob_rw_schemaonly_dummy payload migrate:create"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
